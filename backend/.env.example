# ============================================
# Phorocket API — variables de entorno
# Copia este archivo a .env y completa los valores
# ============================================

# Entorno
NODE_ENV=development
PORT=4000

# Origenes permitidos (separados por coma) para CORS
CORS_ORIGINS=http://localhost:5173

# Base de datos
# OBJETIVO (MySQL):  mysql://root:tu_password@localhost:3306/phorocket
# DESARROLLO (SQL Server local): ver database/scripts/
DATABASE_URL=sqlserver://localhost:1433;database=phorocket;user=phorocket_user;password=tu_password;trustServerCertificate=true;encrypt=true

# JWT — genera secretos fuertes: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Aura AI (opcional — el usuario puede usar su propia clave)
GEMINI_API_KEY=
