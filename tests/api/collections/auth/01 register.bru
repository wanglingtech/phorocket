meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  {
    "email": "{{$timestamp}}@phorocket.dev",
    "password": "Fenix2026!",
    "displayName": "Usuario Bruno",
    "acceptTerms": true,
    "language": "es"
  }
  auth: none
}

post-response {
  const res = bruno.response;
  if (res.getStatus() === 201) {
    const body = res.getBody();
    bru.setVar("accessToken", body.accessToken);
    bru.setVar("refreshToken", body.refreshToken);
    bru.setVar("userId", body.user.id);
    console.log("✔ Tokens guardados tras register");
  }
}

assert {
  res.status: eq 201
  res.body.user.email: isDefined
  res.body.accessToken: isDefined
}

docs {
  Registra un usuario nuevo. Guarda accessToken y refreshToken en variables.
  Requiere MySQL con migraciones aplicadas.
}
