meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  {
    "email": "{{$timestamp}}@phorocket.dev",
    "password": "Fenix2026!"
  }
  auth: none
}

post-response {
  const res = bruno.response;
  if (res.getStatus() === 200) {
    const body = res.getBody();
    bru.setVar("accessToken", body.accessToken);
    bru.setVar("refreshToken", body.refreshToken);
  }
}

assert {
  res.status: either [200, 401]
}

docs {
  Login con credenciales. Guarda tokens si el login es correcto.
  Ajusta el email manualmente o ejecuta Register primero y copia el email.
}
