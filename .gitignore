# ==========================================
# Phorocket — .gitignore (raíz del monorepo)
# ==========================================

# ------------------------------------------
# 1. DEPENDENCIAS
# ------------------------------------------
node_modules/
jspm_packages/
.pnpm-store/
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ------------------------------------------
# 2. BUILD / COMPILACIÓN
# ------------------------------------------
build/
dist/
out/
.next/
.nuxt/
.svelte-kit/
.astro/
.output/
.turbo/
.cache/
*.tsbuildinfo

# ------------------------------------------
# 3. SEGURIDAD Y SECRETOS (CRÍTICO)
# ------------------------------------------
# Cualquier .env en cualquier carpeta (backend/, database/, frontend/, ...)
.env
.env.*
!.env.example
!.env.*.example

# Claves y certificados sueltos
*.pem
*.crt
*.key
*.p12
*.pfx
credentials.json
service-account*.json
secrets.json

# ------------------------------------------
# 4. LOGS
# ------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# 5. PRUEBAS / COBERTURA
# ------------------------------------------
coverage/
.nyc_output/
.stryker-tmp/
playwright-report/
blob-report/
test-results/
cypress/videos/
cypress/screenshots/

# ------------------------------------------
# 6. SISTEMA OPERATIVO
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------
# 7. IDEs / EDITORES
# ------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
.claude/
.cursor/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------
# 8. TEMPORALES / CLOUD
# ------------------------------------------
.serverless/
.aws-sam/
.terraform/
*.tfstate*
*.pid
*.pid.lock
*.dmp
*.bak
*.orig

# ------------------------------------------
# 9. PHOROCKET — ESPECÍFICO DEL PROYECTO
# ------------------------------------------
# Cliente Prisma generado (regenerar con: pnpm db:generate)
database/src/generated/

# Bases de datos locales (modo local SQLite + sidecars WAL/SHM)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite

# Bruno: entornos locales con tokens (los .bru con solo baseUrl sí se suben)
tests/api/.env

# Blobs de audio y contenido de usuarios (nunca en git ni en BD)
storage/
uploads/
backups/
